mkdf$(EXEEXT): $(mkdf_OBJECTS) $(mkdf_DEPENDENCIES) 
	@rm -f mkdf$(EXEEXT)
	$(LINK) $(mkdf_OBJECTS) $(mkdf_LDADD) $(LIBS)

mostlyclean-compile:
	-rm -f *.$(OBJEXT)

distclean-compile:
	-rm -f *.tab.c

