	$(LINK) $(dataman_srv_OBJECTS) $(dataman_srv_LDADD) $(LIBS)
dbclean$(EXEEXT): $(dbclean_OBJECTS) $(dbclean_DEPENDENCIES) 
	@rm -f dbclean$(EXEEXT)
	$(LINK) $(dbclean_OBJECTS) $(dbclean_LDADD) $(LIBS)
dfedit$(EXEEXT): $(dfedit_OBJECTS) $(dfedit_DEPENDENCIES) 
	@rm -f dfedit$(EXEEXT)
	$(dfedit_LINK) $(dfedit_OBJECTS) $(dfedit_LDADD) $(LIBS)
dnodes$(EXEEXT): $(dnodes_OBJECTS) $(dnodes_DEPENDENCIES) 
	@rm -f dnodes$(EXEEXT)
	$(LINK) $(dnodes_OBJECTS) $(dnodes_LDADD) $(LIBS)
dumpdf$(EXEEXT): $(dumpdf_OBJECTS) $(dumpdf_DEPENDENCIES) 
